{
	"modules": {
		"pins/audioin": [
			"./audioin"
		]
	},
	"preload": [
		"pins/audioin"
	],
	"platforms": {
		"esp32/*": {
			"modules": {
				"pins/audioin": [
					"./audioin",
					"./esp32/audioin"
				]
			}
		},
		"...": {
			"warning": "Using AudioIn simulator",
			"include": [
				"$(MODDABLE)/modules/data/wavreader/manifest.json"
			],
			"modules": {
				"*": "./sim/audioin"
			},
			"data": {
				"sim": "$(MODDABLE)/examples/assets/sounds/bflatmajor"
			}
		}
	}
}
